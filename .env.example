# Admin authentication for /admin
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password
ADMIN_SESSION_SECRET=replace_with_a_long_random_string

# Publishing authorization for the admin content form
PUBLISH_TOKEN=replace_with_a_long_random_token

# Optional GitHub-backed content storage
GITHUB_CONTENT_TOKEN=github_fine_grained_token_with_contents_write_access
GITHUB_REPOSITORY=your-user-or-org/your-repo
GITHUB_BRANCH=main

# Optional analytics
NEXT_PUBLIC_GA_ID=

# Contact form delivery through Gmail SMTP
GMAIL_SMTP_USER=your_google_account@gmail.com
GMAIL_SMTP_APP_PASSWORD=your_google_app_password
GMAIL_SMTP_FROM=support@earnpouch.com
